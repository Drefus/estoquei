{
  "name": "prateleira",
  "version": "0.1.0",
  "description": "Prateleira: controle de estoque simples (trabalho de Engenharia de Software 2)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env STORAGE=memory tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env STORAGE=memory vitest run",
    "test:watch": "cross-env STORAGE=memory vitest",
    "test:coverage": "cross-env STORAGE=memory vitest run --coverage",
    "test:e2e": "cross-env STORAGE=memory playwright test",
    "db:migrate": "node dist/db/migrateCli.js"
  },
  "license": "MIT",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
